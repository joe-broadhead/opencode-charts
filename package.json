{
  "name": "@joe-broadhead/opencode-charts",
  "version": "0.0.3",
  "private": true,
  "description": "Unofficial OpenCode plugin: deterministic, themed charts from Vega-Lite, Vega and ECharts specs, rendered offline to SVG, PNG and interactive HTML",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "charts",
    "vega-lite",
    "vega",
    "echarts",
    "dataviz"
  ],
  "homepage": "https://github.com/joe-broadhead/opencode-charts#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-charts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-charts.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ]
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "test:pack": "node scripts/check.mjs pack",
    "drift": "bun scripts/drift.mjs",
    "gallery": "bun scripts/gallery.ts",
    "eval": "bun eval/run.ts",
    "data": "node scripts/data.mjs",
    "cookbook": "bun scripts/cookbook.ts",
    "eval:recommend": "bun eval/recommend.ts"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opencode/sdk": "2.2.5",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/bun": "1.4.4",
    "d3-format": "3.1.0",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "hyparquet": "1.32.0",
    "hyparquet-writer": "0.18.0",
    "i18n-iso-countries": "7.14.0",
    "playwright-core": "1.65.0",
    "solid-js": "1.9.17",
    "typescript": "5.9.3",
    "us-atlas": "3.0.1",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0",
    "vega-tooltip": "1.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.6.7"
  },
  "jelly": {
    "title": "Charts",
    "summary": "Charts, maps and diagrams drawn from your data and workspace files.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "charts.render",
        "permission": "charts_render",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "charts.quick",
        "permission": "charts_quick",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "charts.validate",
        "permission": "charts_validate",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "charts.update",
        "permission": "charts_update",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "charts.recommend",
        "permission": "charts_recommend",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "charts.capabilities",
        "permission": "charts_capabilities",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "charts.catalogue",
        "permission": "charts_catalogue",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "charts.themes",
        "permission": "charts_themes",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "charts.theme_save",
        "permission": "charts_theme_save",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "charts",
      "charts-cookbook"
    ],
    "rpc": [],
    "views": [],
    "signIns": [],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin's tools may do. Generates default rules for agents with a base allow rule.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all"
        }
      ]
    }
  }
}
